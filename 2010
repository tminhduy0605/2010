<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Món Quà Bí Mật ✨</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <style>
    body { -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
    @keyframes bounce-slow { 0%, 100% { transform: translateY(-8%); } 50% { transform: translateY(0); } }
    .animate-bounce-slow { animation: bounce-slow 2s infinite ease-in-out; }
  </style>
</head>
<body class="bg-gradient-to-b from-pink-100 via-purple-50 to-pink-200 min-h-screen font-sans text-gray-800 flex flex-col justify-between max-w-md mx-auto shadow-2xl relative border-x border-pink-200 p-4">

  <header class="text-center pt-4">
    <div class="inline-block bg-white/70 backdrop-blur-md px-4 py-1 rounded-full text-xs font-bold text-pink-600 mb-1 border border-pink-200 shadow-sm">
      🎁 SPECIAL GIFT FOR CLASS
    </div>
    <h1 class="text-2xl font-extrabold text-pink-600 drop-shadow-sm">Món Quà Bí Mật ✨</h1>
  </header>

  <main id="demo-app" class="my-auto w-full flex justify-center items-center py-4">
    <!-- UI JS -->
  </main>

  <footer class="text-center text-xs text-pink-400 font-medium pb-2">
    Demo xem thử trên điện thoại • 2026
  </footer>

  <script>
    const CONFIG = { adminPass: "admin" };
    const LIST_NU = [
      "Minh Anh", "Phương Thảo", "Khánh Linh", "Thanh Hằng", "Ngọc Mai",
      "Bảo Ngọc", "Ánh Dương", "Hà Phương", "Thu Trang", "Linh Chi",
      "Quỳnh Anh", "Hải Yến", "Tố Uyên", "Mỹ Duyên", "Phương Anh",
      "Tường Vi", "Mai Phương", "Cẩm Tú"
    ];

    const DATA_NAM = Array.from({ length: 18 }, (_, i) => {
      const idNum = String(i + 1).padStart(2, '0');
      return {
        id: `nam_${idNum}`,
        name: `Bạn Nam ${idNum}`,
        videoUrl: `https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4`,
        transcript: `Chúc {TEN_NU} luôn luôn xinh đẹp, học giỏi, vui vẻ và gặp thật nhiều may mắn trong năm học mới này nhé! 💖`
      };
    });

    const demoApp = document.getElementById('demo-app');

    function renderLogin() {
      demoApp.innerHTML = `
        <div class="bg-white/80 backdrop-blur-md rounded-3xl p-6 shadow-xl text-center border border-pink-200 w-full">
          <div class="text-5xl mb-3">🌸</div>
          <h2 class="text-xl font-bold text-gray-800 mb-2">Bạn tên là gì thế?</h2>
          <p class="text-xs text-gray-500 mb-4">Chọn tên bạn nữ để mở quà (hoặc nhập mã BTC "admin")</p>
          
          <div class="space-y-3">
            <select id="user-select" class="w-full p-3 rounded-2xl border border-pink-300 bg-white text-gray-700 font-semibold focus:outline-none text-sm">
              <option value="">-- Chọn tên bạn Nữ --</option>
              ${LIST_NU.map(name => `<option value="${name}">${name}</option>`).join('')}
            </select>

            <div class="text-xs text-gray-400 my-1">- Hoặc nhập mã BTC -</div>

            <input type="password" id="admin-input" placeholder="Mã BTC (nhập: admin)" 
                   class="w-full p-3 rounded-2xl border border-purple-200 bg-white/50 text-sm text-center focus:outline-none">

            <button onclick="handleStartDemo()" 
                    class="w-full bg-gradient-to-r from-pink-500 to-purple-500 text-white font-bold py-3.5 px-6 rounded-2xl shadow-lg hover:brightness-110 active:scale-95 transition text-sm">
              Vào Mở Quà ngay 🎁
            </button>
          </div>
        </div>
      `;
    }

    function handleStartDemo() {
      const selectedNu = document.getElementById('user-select').value;
      const adminPass = document.getElementById('admin-input').value.trim();

      if (adminPass === CONFIG.adminPass) {
        renderAdmin();
        return;
      }

      if (!selectedNu) {
        alert("Vui lòng chọn tên bạn nữ hoặc nhập mã 'admin'!");
        return;
      }

      let assignedBoyId = localStorage.getItem(`gift_${selectedNu}`);

      if (!assignedBoyId) {
        let takenIds = JSON.parse(localStorage.getItem('taken_boys') || '[]');
        let availableBoys = DATA_NAM.filter(b => !takenIds.includes(b.id));

        if (availableBoys.length === 0) {
          alert("Hệ thống báo: Đã hết quà bí mật chưa được bốc!");
          return;
        }

        const randomBoy = availableBoys[Math.floor(Math.random() * availableBoys.length)];
        assignedBoyId = randomBoy.id;

        takenIds.push(assignedBoyId);
        localStorage.setItem('taken_boys', JSON.stringify(takenIds));
        localStorage.setItem(`gift_${selectedNu}`, assignedBoyId);
      }

      const boyData = DATA_NAM.find(b => b.id === assignedBoyId);
      renderBox(selectedNu, boyData);
    }

    function renderBox(nuName, boyData) {
      demoApp.innerHTML = `
        <div class="bg-white/80 backdrop-blur-md rounded-3xl p-6 shadow-xl text-center border border-pink-200 w-full">
          <p class="text-xs uppercase tracking-widest text-pink-500 font-bold mb-1">Món quà dành riêng cho</p>
          <h2 class="text-2xl font-extrabold text-purple-700 mb-4">${nuName} ✨</h2>
          
          <div class="text-7xl my-6 cursor-pointer animate-bounce-slow" onclick="openBox('${nuName}', '${boyData.id}')">
            🎁
          </div>

          <button onclick="openBox('${nuName}', '${boyData.id}')" 
                  class="w-full bg-gradient-to-r from-pink-500 to-purple-500 text-white font-bold py-3.5 px-6 rounded-2xl shadow-md active:scale-95 transition text-sm">
            Bóc tem món quà 💌
          </button>
        </div>
      `;
    }

    function openBox(nuName, boyId) {
      if (typeof confetti === 'function') {
        confetti({ particleCount: 100, spread: 60, origin: { y: 0.6 } });
      }

      const boyData = DATA_NAM.find(b => b.id === boyId);
      const personalizedSpeech = boyData.transcript.replace(/{TEN_NU}/g, nuName);

      demoApp.innerHTML = `
        <div class="bg-white/90 backdrop-blur-md rounded-3xl p-5 shadow-2xl text-center border border-pink-200 w-full space-y-4">
          <h3 class="text-xl font-bold text-pink-600">Gửi bạn ${nuName} ❤️</h3>
          
          <div class="relative aspect-[9/16] max-h-[300px] w-full rounded-2xl overflow-hidden shadow-lg bg-black mx-auto">
            <video id="demo-video" controls autoplay class="w-full h-full object-contain">
              <source src="${boyData.videoUrl}" type="video/mp4">
            </video>
          </div>

          <div class="bg-pink-50 p-3 rounded-2xl border border-pink-100 text-xs text-pink-800 text-left leading-relaxed">
            <span class="font-bold text-pink-600 block mb-1">💌 Lời chúc gửi tới ${nuName}:</span>
            "${personalizedSpeech}"
          </div>

          <div class="space-y-2 pt-1">
            <button onclick="alert('Đã kích hoạt tải video cho ${nuName}!')" 
                    class="w-full bg-green-500 text-white font-bold py-2.5 px-4 rounded-xl shadow text-xs active:scale-95 transition">
              📥 Tải Video này về điện thoại
            </button>

            <button onclick="if(typeof confetti==='function') confetti({particleCount: 50});" 
                    class="w-full bg-pink-100 text-pink-600 font-bold py-2.5 px-4 rounded-xl text-xs active:scale-95 transition">
              💖 Thả tim / Cảm ơn
            </button>

            <button onclick="renderLogin()" 
                    class="w-full bg-gray-100 text-gray-600 font-bold py-2 px-4 rounded-xl text-xs">
              🔄 Về màn hình chính
            </button>
          </div>
        </div>
      `;
    }

    function renderAdmin() {
      const takenBoys = JSON.parse(localStorage.getItem('taken_boys') || '[]');

      demoApp.innerHTML = `
        <div class="bg-white/95 backdrop-blur-md rounded-3xl p-5 shadow-2xl w-full border border-purple-200 text-left space-y-4">
          <div class="flex justify-between items-center border-b pb-3">
            <h2 class="text-lg font-bold text-purple-800">🛠 Bảng Quản Trị BTC</h2>
            <span class="text-xs bg-purple-100 text-purple-700 font-semibold px-2.5 py-1 rounded-full">
              Đã bốc: ${takenBoys.length}/18
            </span>
          </div>

          <div class="bg-red-50 p-3 rounded-2xl border border-red-200">
            <p class="text-xs text-red-600 font-medium mb-2">Xóa dữ liệu bốc thử trước khi vào sự kiện thật:</p>
            <button onclick="resetDemo()" 
                    class="w-full bg-red-500 text-white font-bold py-2 px-4 rounded-xl text-xs shadow active:scale-95 transition">
              🔄 RESET TOÀN BỘ DỮ LIỆU VỀ 0
            </button>
          </div>

          <div class="space-y-2">
            <h3 class="text-xs font-bold text-gray-700 uppercase">Danh sách bạn Nữ & Quà:</h3>
            <div class="max-h-[180px] overflow-y-auto space-y-1.5 pr-1 text-xs">
              ${LIST_NU.map(nu => {
                const boyId = localStorage.getItem(`gift_${nu}`);
                const boy = DATA_NAM.find(b => b.id === boyId);
                return `
                  <div class="p-2 rounded-xl bg-gray-50 border border-gray-200 flex justify-between items-center">
                    <span class="font-semibold text-gray-800">${nu}</span>${boy 
                      ? `<span class="text-green-600 font-bold">🎁 ${boy.name}</span>` 
                      : `<span class="text-gray-400 font-normal">Chưa bốc</span>`}
                  </div>
                `;
              }).join('')}
            </div>
          </div>

          <button onclick="renderLogin()" 
                  class="w-full bg-gray-200 text-gray-700 font-bold py-2.5 rounded-xl text-xs">
            ⬅️ Thoát trang BTC
          </button>
        </div>
      `;
    }

    function resetDemo() {
      localStorage.clear();
      alert("Đã reset dữ liệu chạy thử về 0!");
      renderAdmin();
    }

    renderLogin();
  </script>
</body>
</html>
